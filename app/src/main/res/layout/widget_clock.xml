<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/date_block"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.02"
        android:gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/hour_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hour_tens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="1"
                android:textColor="@color/widget_text"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hour_ones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="8"
                android:textColor="@color/widget_text"
                android:textSize="64sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Thứ Hai"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_solar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="24/08/2026"
            android:textColor="@color/widget_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_lunar_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Âm lịch: 12 tháng 7"
            android:textColor="@color/widget_muted"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather_block"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.18"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingStart="6dp">

        <LinearLayout
            android:id="@+id/weather_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_low_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="▼ 27°"
                        android:textColor="@color/widget_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_high_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans"
                        android:text="▲ 33°"
                        android:textColor="@color/widget_yellow"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/location_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="3dp">

                    <ImageView
                        android:id="@+id/iv_location"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans"
                        android:maxLines="1"
                        android:paddingStart="5dp"
                        android:shadowColor="#99000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="Gò Vấp"
                        android:textColor="@color/widget_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_condition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans"
                    android:maxLines="1"
                    android:paddingTop="1dp"
                    android:shadowColor="#99000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="Mưa"
                    android:textColor="@color/widget_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_weather_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription=""
                android:padding="2dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_weather_sun" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_minute"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal|top"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="32"
            android:textColor="@color/widget_text"
            android:textSize="64sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
