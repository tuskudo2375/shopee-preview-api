<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#243945" android:endColor="#202531" />
            <stroke android:width="1.2dp" android:color="#BCEFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#171A1E" />
            <stroke android:width="1dp" android:color="#44FFFFFF" />
        </shape>
    </item>
</selector>
